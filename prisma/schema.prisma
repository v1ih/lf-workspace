// LF Workspace — database schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  title          String   @default("Full Stack Developer · Founder")
  companyName    String   @default("Lavínia Ferraz | Soluções Digitais")
  githubUsername String?
  createdAt      DateTime @default(now())

  clients      Client[]
  projects     Project[]
  sprints      Sprint[]
  tasks        Task[]
  timeEntries  TimeEntry[]
  workdays     Workday[]
  leads        Lead[]
  transactions Transaction[]
  applications JobApplication[]
  skills       Skill[]
  goals        Goal[]
  activities   ActivityLog[]
  achievements Achievement[]
}

// ─────────────────────────────────────────────
// Work
// ─────────────────────────────────────────────

enum ClientStatus {
  ACTIVE
  DEVELOPMENT
  PAUSED
  CLOSED
}

model Client {
  id         String       @id @default(cuid())
  userId     String
  name       String
  segment    String?
  status     ClientStatus @default(ACTIVE)
  country    String       @default("Brazil")
  hourlyRate Decimal?     @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects     Project[]
  transactions Transaction[]
  leads        Lead[]

  @@index([userId])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  SHIPPED
  ARCHIVED
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  clientId    String?
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  repoUrl     String?
  color       String        @default("#C0613D")
  createdAt   DateTime      @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks       Task[]
  timeEntries TimeEntry[]

  @@index([userId])
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Sprint {
  id        String       @id @default(cuid())
  userId    String
  name      String
  goal      String?
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    SprintStatus @default(PLANNED)
  createdAt DateTime     @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  CODE_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  FRONTEND
  BACKEND
  FULL_STACK
  TESTING
  DEVOPS
  DOCS
  BUSINESS
  CAREER
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  // Human-friendly sequential number, shown as LF-001
  number      Int
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  type        TaskType     @default(FULL_STACK)
  position    Int          @default(0)
  estimate    Float?
  prUrl       String?
  projectId   String?
  sprintId    String?
  dueDate     DateTime?    @db.Date
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sprint      Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@unique([userId, number])
  @@index([userId, status])
}

model TimeEntry {
  id          String    @id @default(cuid())
  userId      String
  taskId      String?
  projectId   String?
  description String?
  startedAt   DateTime  @default(now())
  // null while the timer is running
  endedAt     DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
}

model Workday {
  id        String    @id @default(cuid())
  userId    String
  date      DateTime  @db.Date
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  notes     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ─────────────────────────────────────────────
// Business
// ─────────────────────────────────────────────

enum LeadStage {
  LEAD
  CONTACTED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Lead {
  id           String    @id @default(cuid())
  userId       String
  company      String
  contactName  String?
  contactInfo  String?
  service      String?
  value        Decimal?  @db.Decimal(10, 2)
  stage        LeadStage @default(LEAD)
  source       String?
  notes        String?
  nextFollowUp DateTime? @db.Date
  contactedAt  DateTime?
  clientId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId, stage])
}

enum Currency {
  BRL
  USD
}

enum IncomeStream {
  EMPLOYMENT
  BUSINESS
}

enum TransactionStatus {
  RECEIVED
  EXPECTED
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  stream      IncomeStream
  status      TransactionStatus @default(RECEIVED)
  amount      Decimal           @db.Decimal(12, 2)
  currency    Currency          @default(BRL)
  description String
  date        DateTime          @db.Date
  recurring   Boolean           @default(false)
  clientId    String?
  createdAt   DateTime          @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

// ─────────────────────────────────────────────
// Career
// ─────────────────────────────────────────────

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  TECHNICAL
  OFFER
  CLOSED
}

model JobApplication {
  id          String            @id @default(cuid())
  userId      String
  company     String
  position    String
  country     String?
  salary      Decimal?          @db.Decimal(12, 2)
  currency    Currency          @default(USD)
  remote      Boolean           @default(true)
  technology  String?
  url         String?
  status      ApplicationStatus @default(SAVED)
  // Furthest stage reached — kept even after the application is closed,
  // so the funnel stays honest ("2 interviews" doesn't disappear on rejection)
  furthest    ApplicationStatus @default(SAVED)
  appliedAt   DateTime?         @db.Date
  interviewAt DateTime?
  followUpAt  DateTime?         @db.Date
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Skill {
  id        String   @id @default(cuid())
  userId    String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidences SkillEvidence[]

  @@unique([userId, name])
}

// A skill only grows with evidence: shipped auth, wrote tests, deployed...
model SkillEvidence {
  id        String   @id @default(cuid())
  skillId   String
  title     String
  points    Int
  url       String?
  date      DateTime @default(now()) @db.Date
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Goals, activity & gamification
// ─────────────────────────────────────────────

model Goal {
  id     String @id @default(cuid())
  userId String
  // Month the goal applies to, as "YYYY-MM"
  period String
  // Metric key, see src/lib/goals.ts
  metric String
  target Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, metric])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  key        String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}
